node_modules/
dist/
*.log
.env
.env.*

# Personal data never belongs in this repo. The workspace defaults to ~/.resumetron;
# these patterns catch one created here by accident.
.resumetron/
pool.yaml
goal.yaml
answers.yaml
applications/
ledger.db*
*.pdf
stories.yaml
Connections.csv

# Private working state, product intent and evidence: kept on the owner's machine, never
# published. They can name real employers and applications, and hold the hosted
# product's plans. Only the rules (READMEs) and technical decisions are public.
/ai_state/*
!/ai_state/README.md
!/ai_state/TECH_DECISIONS.md
/docs/spec/*
!/docs/spec/README.md
