{
  "name": "resumetron-9000",
  "version": "0.1.0",
  "description": "If employers are screening with AI, I'm submitting with AI. A provider-agnostic job application agent.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "resumetron": "dist/cli.js"
  },
