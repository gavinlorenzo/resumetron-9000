    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.ts\"",
    "browsers": "playwright install chromium"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "commander": "^15.1.0",
    "imapflow": "^2.11.0",
    "mailparser": "^3.14.2",
    "nodemailer": "^10.4.0",
    "playwright": "^1.65.0",
    "unpdf": "^2.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^7.0.2"
  }
}
