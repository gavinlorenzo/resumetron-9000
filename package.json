    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
